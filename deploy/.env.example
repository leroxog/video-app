# Copy this file to ".env" in the main folder (cp deploy/.env.example .env) and fill in the values. Never put the file on GitHub.

# --- the address of the site and the database
SITE_ADDRESS=saturn.duckdns.org
DB_PASSWORD=change-this-to-a-long-random-password
# a long random text (for example: openssl rand -hex 32); the same one must stay for ever, or everybody is signed out
SECRET_KEY=change-this-too

# --- the owner and the legal page
YIPI_ADMINS=lerox
IMPRESSUM_NAME=
IMPRESSUM_ADDRESS=
IMPRESSUM_EMAIL=

# --- Cloudflare R2 (pictures, stickers, songs); the same values as on Railway
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- Bunny Stream (videos, made small at Bunny): the library is set to 480p and 360p with "MP4 Fallback" on
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_CDN_HOST=
BUNNY_HEIGHT=480

# --- the AI services; the same values as on Railway
GROQ_API_KEY=
POLLINATIONS_API_KEY=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- backups of the database to an R2 bucket of its own (see deploy/backup.sh)
BACKUP_BUCKET=
BACKUP_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
